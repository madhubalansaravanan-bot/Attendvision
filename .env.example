# Copy to .env and fill in, or export these before running the app.
# (This prototype reads plain env vars — use `export`, a shell profile,
# or a tool like `python-dotenv` / `direnv` if you want a .env file loaded.)

DATABASE_URL=data/attendvision.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SECRET_KEY=change-this-to-a-random-string
